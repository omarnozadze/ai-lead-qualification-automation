      "parameters": {
        "jsCode": "const incoming = $('Prepare CRM Row1').first().json;\nconst prior = $input.first().json || {};\nconst found = String(prior.submission_id ?? '').trim() === String(incoming.submission_id).trim();\nconst sentAt = found ? String(prior.notification_sent_at ?? '').trim() : '';\nconst createdAt = found && prior.created_at ? prior.created_at : incoming.created_at;\n// Preserve the notification flag when updating an existing CRM record.\nreturn [{ json: {\n  ...incoming,\n  created_at: createdAt,\n  notification_sent_at: sentAt,\n  notification_due: incoming.priority === 'High' && sentAt.length === 0,\n  notification_previously_sent: sentAt.length > 0\n} }];"
      },
