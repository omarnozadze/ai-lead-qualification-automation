    {
      "parameters": {
        "jsCode": "const lead = $input.first().json.body ?? $input.first().json;\nconst name = String(lead.name ?? '').trim();\nconst email = String(lead.email ?? '').trim().toLowerCase();\nconst company = String(lead.company ?? '').trim();\nconst message = String(lead.message ?? '').trim();\nconst budget = (lead.budget === '' || lead.budget === null || lead.budget === undefined) ? NaN : Number(lead.budget);\nconst submission_id = String(lead.submission_id ?? '').trim();\nconst errors = [];\nif (!submission_id) errors.push('submission_id required');\nif (!name) errors.push('name required');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('invalid email');\nif (!Number.isFinite(budget) || budget < 0) errors.push('invalid budget');\nif (!message) errors.push('message required');\nreturn [{json:{submission_id,name,email,company,budget:Number.isFinite(budget)?budget:null,message,valid:errors.length===0,errors}}];"
      },
